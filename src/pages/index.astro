---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaExplorer from '../components/IdeaExplorer';
import NailCollectionGrid from '../components/NailCollectionGrid.astro';
import { loadNails, toNailSearchRecords } from '../libs/nails';
import { formatFacetLabel, getFacetPages, isIndexablePage, type NailFacetPage } from '../libs/seo-pages';

import { nailAreas } from '../areas';
const nails = await loadNails();
const searchRecords = toNailSearchRecords(nails);
const featuredNails = nails.slice(0, 9);
const facetPages = nailAreas.flatMap((area) => getFacetPages(nails, area));
const categoryDefinitions: { title: string; description: string; matches: (page: NailFacetPage) => boolean }[] = [
	{ title: 'Nail shapes', description: 'Almond, square, round, oval, coffin, and more. Pick a shape that suits your nail length and daily routine.', matches: (page) => page.kind === 'shape' },
	{ title: 'Nail colors', description: 'From soft nudes and milky pinks to burgundy, red, and chrome. Find shades to suit your wardrobe and personal style.', matches: (page) => page.kind === 'color' },
	{ title: 'Nail designs by occasion', description: 'Wedding, office, date night, vacation, birthday, and holiday nails, chosen to fit the moment.', matches: (page) => page.kind === 'occasion' },
	{ title: 'Seasonal nails', description: 'Fresh spring pastels, summer brights, deep autumn tones, and winter classics.', matches: (page) => page.kind === 'season' },
	{ title: 'French and micro French', description: 'Classic white tips, thin micro French lines, and colored variations that stay polished and wearable.', matches: (page) => page.kind === 'type' && /french/i.test(page.value) },
	{ title: 'Short nails', description: 'Neat, low-maintenance ideas for short nails that still look intentional.', matches: (page) => page.kind === 'length' && page.value.toLowerCase() === 'short' },
];
const categories = categoryDefinitions.map((category) => ({
	...category,
	pages: facetPages.filter((page) => isIndexablePage(page.nails.length) && category.matches(page)),
}));
const title = 'Manicure and Pedicure Ideas, Matched to You | Nail.ai';
const description = 'Browse manicure and pedicure ideas by color, shape, and occasion, or describe your look and get matching nail designs.';
const canonical = new URL('/', Astro.site ?? new URL('https://nail.ai')).toString();
const socialImage = 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=85';
const faqItems = [
	{
		question: 'How do I choose the right nail shape?',
		answer: 'Start with your preferred nail length and daily routine. Square and squoval are common choices for short nails; round and oval follow a softer curve, while almond tapers toward the tip. The best fit depends on your natural nails and preference, so ask your nail tech to recommend a shape before filing.',
	},
	{
		question: 'What is a micro French manicure?',
		answer: 'A micro French is a French manicure with a much thinner tip line than the classic version. It looks subtle and modern, and works well on short nails with nude, milky, or deeper shades like burgundy.',
	},
	{
		question: 'Which nail colors work for the office or an interview?',
		answer: 'Soft nudes, milky pinks, sheer neutrals, and classic French tips are understated options for many offices and interviews. A glossy finish can keep the look polished; dress codes and personal preference vary.',
	},
	{
		question: 'How long does a manicure or pedicure last?',
		answer: 'Wear depends on the polish, application, nail growth, and daily activity. Regular polish may chip within about a week; gel manicures often last around two to three weeks. Pedicure polish can last longer because toenails grow more slowly and usually get less daily wear. Follow your nail tech’s care and removal advice.',
	},
	{
		question: 'What’s the difference between manicure and pedicure ideas?',
		answer: 'Manicures are for your hands and pedicures are for your feet. Pedicures can be a place to try brighter shades, while manicure ideas often focus on everyday or work settings. Designs such as French tips and solid colors can work for either.',
	},
	{
		question: 'How does the Nail.ai idea finder work?',
		answer: 'Type a short description of the nails you imagine. The idea finder parses details it recognizes, such as color, shape, length, finish, and occasion, then ranks designs in the collection and shows up to three close matches. Add details or try a different description to refine the results.',
	},
];
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebApplication',
			'@id': `${canonical}#app`,
			name: 'Nail.ai',
			url: canonical,
			description,
			applicationCategory: 'LifestyleApplication',
			operatingSystem: 'Any',
			image: socialImage,
		},
		{
			'@type': 'FAQPage',
			'@id': `${canonical}#faq`,
			mainEntity: faqItems.map(({ question, answer }) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer },
			})),
		},
	],
};
---

<BaseLayout title={title} description={description} canonical={canonical} socialImage={socialImage} structuredData={structuredData}>
	<IdeaExplorer nails={searchRecords} client:idle />
	<main class="mx-auto w-full max-w-[1440px] space-y-10 px-5 pb-14 sm:px-8 lg:px-14">
		<section class="max-w-3xl space-y-4" aria-labelledby="home-seo-title">
			<h2 id="home-seo-title" class="font-display text-3xl text-[#172b24]">Find manicure and pedicure ideas by color, shape, and occasion</h2>
			<p class="text-base leading-7 text-[#617269]">Not sure what to ask your nail tech for when looking for manicure and pedicure ideas? Nail.ai turns a vague thought into a plan for nail designs: describe a nail shape, color, and finish, like “short almond nails, glossy nude, French tips for a wedding.” We’ll show the closest designs in the collection. Browse manicure ideas and pedicure ideas, then bring a design you like to your appointment. Add details or try another description to refine your search.</p>
			<nav aria-label="Browse nail services" class="flex flex-wrap gap-x-6 gap-y-3">
				{nailAreas.map((area) => (
					<a class="text-sm font-bold text-[#45594d] underline decoration-[#c7d0c5] underline-offset-4 transition-colors hover:text-[#d6694c]" href={`/${area}/`}>
						{area === 'manicure' ? 'Manicure ideas' : 'Pedicure ideas'}
					</a>
				))}
			</nav>
		</section>
		<section aria-labelledby="popular-categories-title">
			<h2 id="popular-categories-title" class="font-display text-3xl text-[#172b24]">Browse nail designs by category</h2>
			<div class="mt-6 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
				{categories.map((category) => (
					<section aria-labelledby={`category-${category.title.toLowerCase().replaceAll(' ', '-')}`}>
						<h3 id={`category-${category.title.toLowerCase().replaceAll(' ', '-')}`} class="font-display text-xl text-[#172b24]">{category.title}</h3>
						<p class="mt-2 text-sm leading-6 text-[#617269]">{category.description}</p>
						{category.pages.length > 0 && (
							<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
								{category.pages.map((page) => (
									<li><a class="text-sm font-semibold text-[#45594d] underline decoration-[#c7d0c5] underline-offset-4 transition-colors hover:text-[#d6694c]" href={`/${page.area}/${page.slug}/`}>{formatFacetLabel(page)} {page.area} ideas</a></li>
								))}
							</ul>
						)}
					</section>
				))}
			</div>
		</section>
		<section aria-labelledby="all-ideas-title">
			<div class="flex flex-wrap items-end justify-between gap-4 border-b border-[#d9dfd4] pb-4">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.14em] text-[#718b42]">From the Nails collection</p>
					<h2 id="all-ideas-title" class="mt-1 font-display text-3xl">Featured nail ideas</h2>
				</div>
				<a class="text-sm font-bold text-[#45594d] underline decoration-[#c7d0c5] underline-offset-4 transition-colors hover:text-[#d6694c]" href="/manicure/">View all manicure ideas</a>
			</div>
			<p class="mt-4 max-w-3xl text-sm leading-6 text-[#617269]">How we curate: designs are organized by color, shape, length, finish, and occasion. All nail design photos are AI-generated visual references and may differ from results on natural nails.</p>
			<NailCollectionGrid items={featuredNails.map((nail) => ({ nail }))} />
		</section>
		<section aria-labelledby="nail-faq-title" class="max-w-3xl">
			<h2 id="nail-faq-title" class="font-display text-3xl text-[#172b24]">Nail idea FAQ</h2>
			<dl class="mt-6 space-y-6">
				{faqItems.map(({ question, answer }) => (
					<div>
						<dt class="font-display text-xl text-[#172b24]">{question}</dt>
						<dd class="mt-2 text-sm leading-6 text-[#617269]">{answer}</dd>
					</div>
				))}
			</dl>
		</section>
	</main>
</BaseLayout>
