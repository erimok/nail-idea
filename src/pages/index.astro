---
import { createReader } from '@keystatic/core/reader';
import { fileURLToPath } from 'node:url';
import keystaticConfig from '../../keystatic.config';
import IdeaExplorer from '../components/IdeaExplorer';
import type { NailRecord } from '../libs/ai/nail-search';
import '../styles/global.css';

const reader = createReader(fileURLToPath(new URL('../../', import.meta.url)), keystaticConfig);
const entries = await reader.collections.nails.all();
const nails: NailRecord[] = entries.map(({ slug, entry }) => ({
	slug,
	title: entry.title,
	image: entry.image ?? '',
	description: entry.description,
	typesOfNails: entry.typesOfNails,
	colors: entry.colors,
	types: entry.types,
	occasions: entry.occasions,
	season: entry.season,
	shape: entry.shape,
	length: entry.length,
	finishes: entry.finishes,
	nailConcerns: entry.nailConcerns,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Shape your next manicure or pedicure idea." />
		<title>Nail.ai | Idea studio</title>
	</head>
	<body>
		<IdeaExplorer nails={nails} client:load />
	</body>
</html>
