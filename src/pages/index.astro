---
import { createReader } from '@keystatic/core/reader';
import { fileURLToPath } from 'node:url';
import keystaticConfig from '../../keystatic.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaExplorer from '../components/IdeaExplorer';
import type { NailRecord } from '../libs/ai/nail-search';

const reader = createReader(fileURLToPath(new URL('../../', import.meta.url)), keystaticConfig);
const entries = await reader.collections.nails.all();
const nails: NailRecord[] = entries.map(({ slug, entry }) => ({
	slug,
	title: entry.title,
	image: entry.image ?? '',
	description: entry.description,
	typesOfNails: entry.typesOfNails,
	colors: entry.colors,
	types: entry.types,
	occasions: entry.occasions,
	season: entry.season,
	shape: entry.shape,
	length: entry.length,
	finishes: entry.finishes,
	nailConcerns: entry.nailConcerns,
}));
const title = 'Nail.ai | Manicure and Pedicure Idea Finder';
const description = 'Describe your manicure or pedicure idea and find matching nail designs by color, style, occasion, shape, and finish.';
const canonical = new URL('/', Astro.site ?? new URL('https://nail.ai')).toString();
const socialImage = 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=85';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	'@id': `${canonical}#app`,
	name: 'Nail.ai',
	url: canonical,
	description,
	applicationCategory: 'LifestyleApplication',
	operatingSystem: 'Any',
	image: socialImage,
};
---

<BaseLayout title={title} description={description} canonical={canonical} socialImage={socialImage} structuredData={structuredData}>
	<IdeaExplorer nails={nails} client:load />
</BaseLayout>
