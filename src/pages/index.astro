---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaExplorer from '../components/IdeaExplorer';
import NailGrid from '../components/NailGrid';
import { loadNails } from '../libs/nails';

import { nailAreas } from '../areas';
const nails = await loadNails();
const title = 'Nail.ai | Manicure and Pedicure Idea Finder';
const description = 'Describe your manicure or pedicure idea and find matching nail designs by color, style, occasion, shape, and finish.';
const canonical = new URL('/', Astro.site ?? new URL('https://nail.ai')).toString();
const socialImage = 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=85';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	'@id': `${canonical}#app`,
	name: 'Nail.ai',
	url: canonical,
	description,
	applicationCategory: 'LifestyleApplication',
	operatingSystem: 'Any',
	image: socialImage,
};
---

<BaseLayout title={title} description={description} canonical={canonical} socialImage={socialImage} structuredData={structuredData}>
	<IdeaExplorer nails={nails} client:load />
	<main class="mx-auto w-full max-w-[1440px] space-y-10 px-5 pb-14 sm:px-8 lg:px-14">
		<section class="max-w-3xl space-y-4" aria-labelledby="home-seo-title">
			<h1 id="home-seo-title" class="font-display text-3xl text-[#172b24]">Find your next nail idea</h1>
			<p class="text-base leading-7 text-[#617269]">Browse manicure and pedicure designs from the Nail.ai collection, or describe the look you have in mind to find ideas by color, style, occasion, and season.</p>
			<nav aria-label="Browse nail services" class="flex flex-wrap gap-x-6 gap-y-3">
				{nailAreas.map((area) => (
					<a class="text-sm font-bold text-[#45594d] underline decoration-[#c7d0c5] underline-offset-4 transition-colors hover:text-[#d6694c]" href={`/${area}/`}>
						{area === 'manicure' ? 'Manicure ideas' : 'Pedicure ideas'}
					</a>
				))}
			</nav>
		</section>
		<section aria-labelledby="all-ideas-title">
			<div class="flex items-end justify-between gap-4 border-b border-[#d9dfd4] pb-4">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.14em] text-[#718b42]">From the Nails collection</p>
					<h2 id="all-ideas-title" class="mt-1 font-display text-3xl">Nail ideas</h2>
				</div>
				<span class="text-xs font-semibold text-[#7c8980]">{nails.length} designs</span>
			</div>
			<NailGrid items={nails.map((nail) => ({ nail }))} />
		</section>
	</main>
</BaseLayout>
