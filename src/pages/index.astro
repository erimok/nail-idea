---
import HomepageView from '../components/HomepageView.astro';
import { nailAreas } from '../domain/areas';
import { getFacetPages } from '../domain/facet-combinations';
import { loadNails, toNailSearchRecords } from '../libs/nails';
import { getHomepageCategories, getHomepageFeatured, homepageFaq } from '../libs/homepage';
import { attachHubEditorial, loadHubEditorial } from '../libs/hubs';

const nails = await loadNails();
const editorial = await loadHubEditorial();
const facetPages = attachHubEditorial(nailAreas.flatMap((area) => getFacetPages(nails, area)), editorial);
---

<HomepageView nails={nails} searchRecords={toNailSearchRecords(nails)} featured={getHomepageFeatured(nails)} categories={getHomepageCategories(facetPages)} faqItems={homepageFaq} />
