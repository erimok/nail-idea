---
import CollectionPageView from '../../components/CollectionPageView.astro';
import { siteServices } from '../../composition';

export async function getStaticPaths() {
	return (await siteServices.listHubRoutes()).areaRoutes.map(({ area }) => ({ params: { area } }));
}

const { area } = Astro.params as { area: 'manicure' | 'pedicure' };
const viewModel = await siteServices.buildAreaPage({ area });
---

<CollectionPageView {...viewModel} />
