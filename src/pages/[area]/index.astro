---
import { nailAreas, type NailArea } from '../../areas';
import CollectionPageView from '../../components/CollectionPageView.astro';
import { loadNails, toNailSearchRecords } from '../../libs/nails';
import { getFacetPages, getNailsForArea, getAreaPageCopy, isIndexablePage } from '../../libs/seo-pages';
import { attachHubEditorial, loadHubEditorial } from '../../libs/hubs';

export function getStaticPaths() {
	return nailAreas.map((area) => ({ params: { area }, props: { area } }));
}

const { area } = Astro.props as { area: NailArea };
const allNails = await loadNails();
const editorial = await loadHubEditorial();
const nails = getNailsForArea(allNails, area);
const facets = attachHubEditorial(getFacetPages(allNails, area), editorial);
const copy = getAreaPageCopy(area, nails);
const areaLabel = area.charAt(0).toUpperCase() + area.slice(1);
const canonical = new URL(`/${area}/`, Astro.site).toString();
---

<CollectionPageView
	area={area}
	title={copy.title}
	description={copy.description}
	canonical={canonical}
	heading={copy.heading}
	prompt={copy.prompt}
	paragraphs={copy.paragraphs}
	nails={nails}
	searchRecords={toNailSearchRecords(nails)}
	noIndex={!isIndexablePage(nails.length)}
	crumbs={[{ label: 'Home', href: '/' }, { label: areaLabel }]}
	relatedPages={facets}
	relatedTitle={`Explore more ${area} ideas`}
	sectionTitle={`All ${area} ideas`}
/>