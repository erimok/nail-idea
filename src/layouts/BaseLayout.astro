---
import type { LayoutViewModel } from '../application/view-models';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props extends LayoutViewModel {}

const {
	title,
	description,
	canonical,
	markdownAlternate,
	socialImage,
	structuredData,
	noIndex = false,
	socialImageAlt = 'AI-generated manicure design from nail-idea.com',
	socialImageDimensions,
	siteChrome,
} = Astro.props;
const serializedStructuredData = structuredData
	? JSON.stringify(structuredData).replace(/</g, '\\u003c')
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={noIndex ? 'noindex,follow' : 'index,follow'} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" /></noscript>
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="nail-idea.com" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && socialImageDimensions && <meta property="og:image:width" content={String(socialImageDimensions.width)} />}
		{socialImage && socialImageDimensions && <meta property="og:image:height" content={String(socialImageDimensions.height)} />}
		{socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		{socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
		{serializedStructuredData && <script type="application/ld+json" set:html={serializedStructuredData} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body class="flex min-h-screen flex-col">
		<SiteHeader {...siteChrome.header} />
		<slot />
		<SiteFooter {...siteChrome.footer} />
	</body>
</html>
