---
interface Props {
	href: string;
	label: string;
}
const { href, label } = Astro.props;
---

<span class="pinterest-widget" data-pinterest-widget data-pinterest-label={label}>
	<a href={href} data-pin-do="buttonPin" data-pin-shape="round" data-pin-tall="true" aria-label={label} title={label} target="_blank" rel="noopener noreferrer">
		<img src="https://assets.pinterest.com/images/pidgets/pinit_fg_en_round_red_32.png" alt="Save to Pinterest" title="Save to Pinterest" width="32" height="32" />
	</a>
</span>
