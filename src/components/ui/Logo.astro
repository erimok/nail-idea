---
interface Props {
	light?: boolean;
}

const { light = false } = Astro.props;
---

<a class="inline-flex shrink-0 items-center font-display text-2xl font-semibold leading-none tracking-tight" href="/" aria-label="Nail Idea home">
	<span class={light ? 'text-white' : 'text-forest'}>Nail</span>
	<span class={light ? 'ml-1 text-lime' : 'ml-1 text-coral'}>Idea</span>
</a>
