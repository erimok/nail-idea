---
interface Props {
	href?: string;
	type?: 'button' | 'submit';
	mobileLarge?: boolean;
}

const { href, type = 'button', mobileLarge = false } = Astro.props;
const className = `inline-flex ${mobileLarge ? 'min-h-11 sm:min-h-10' : 'min-h-10'} items-center rounded-full border border-line bg-surface px-4 text-sm font-semibold text-ink-soft transition hover:border-olive hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive`;
---

{href
	? <a class={className} href={href}><slot /></a>
	: <button class={`${className} cursor-pointer`} type={type}><slot /></button>}