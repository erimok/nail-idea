---
import { Picture } from 'astro:assets';
import type { NailRecord } from '../libs/ai/nail-search';
import { getNailImageMetadata } from '../libs/nail-images';

interface Props {
	title: string;
	description: string;
	href: string;
	nail: NailRecord;
}

const { title, description, href, nail } = Astro.props;
---

<a href={href} class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface p-4 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive">
	<Picture
		src={getNailImageMetadata(nail.image)}
		alt={nail.imageAlt ?? ''}
		width={800}
		height={600}
		widths={[320, 480, 640]}
		sizes="(min-width: 1024px) 32vw, (min-width: 640px) 50vw, 100vw"
		formats={['avif']}
		fallbackFormat="webp"
		fit="cover"
		loading="lazy"
		class="aspect-[4/3] w-full rounded-[1.1rem] object-cover transition duration-700 group-hover:scale-[1.03]"
	/>
	<span class="flex flex-1 flex-col pt-5">
		<strong class="font-display text-2xl font-semibold leading-tight text-ink">{title}</strong>
		<span class="mt-2 text-sm leading-7 text-muted">{description}</span>
		<span class="mt-auto pt-4 text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-olive">Explore designs <span aria-hidden="true">→</span></span>
	</span>
</a>