---
import type { BrowseLinkGroupViewModel } from '../application/view-models';
import Logo from './ui/Logo.astro';

interface Props {
	groups: readonly BrowseLinkGroupViewModel[];
}

const { groups } = Astro.props;
---

<footer class="mt-auto bg-forest text-white">
	<div class="mx-auto w-full max-w-[1440px] px-5 py-12 sm:px-8 lg:px-14">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<Logo light />
				<p class="mt-4 max-w-xs text-sm leading-6 text-white">Manicure inspiration, organized around the details that matter to you.</p>
				<p class="mt-3 max-w-xs text-xs leading-5 text-white">Disclaimer: Images are AI-generated visual references.</p>
			</div>
			{groups.map(({ label, links }) => (
				<div>
					<h2 class="text-xs font-bold uppercase tracking-[0.12em] text-lime">{label}</h2>
					<ul class="mt-4 space-y-2">
						{links.map(({ href, label: linkLabel }) => <li><a class="inline-flex min-h-8 items-center text-sm text-link text-white hover:!text-lime" href={href}>{linkLabel}</a></li>)}
					</ul>
				</div>
			))}
		</div>
		<div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-ink-soft pt-5 text-xs text-white">
			<p>© {new Date().getFullYear()} nail-idea.com</p>
			<nav aria-label="Footer links" class="flex flex-wrap gap-x-5 gap-y-2">
				<a class="text-link font-semibold hover:!text-lime" href="/about/">About</a>
				<a class="text-link font-semibold hover:!text-lime" href="/terms/">Terms of Use</a>
				<a class="text-link font-semibold hover:!text-lime" href="/privacy-policy/">Privacy Policy</a>
			</nav>
		</div>
	</div>
</footer>
