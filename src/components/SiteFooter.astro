---
import type { NailFacetPage } from '../domain/facet-combinations';
import { isIndexable } from '../domain/indexability';
import { buildFacetRoute } from '../domain/routes';
import { formatFacetLabel } from '../libs/seo-pages';
import Logo from './ui/Logo.astro';

interface Props {
	hubs: readonly NailFacetPage[];
}

const { hubs } = Astro.props;
const indexable = hubs.filter(isIndexable);
const groups: { label: string; kind: NailFacetPage['kind'] }[] = [
	{ label: 'Shapes', kind: 'shape' },
	{ label: 'Colors', kind: 'color' },
	{ label: 'Occasions', kind: 'occasion' },
	{ label: 'Seasons', kind: 'season' },
];
---

<footer class="mt-auto bg-forest text-white">
	<div class="mx-auto w-full max-w-[1440px] px-5 py-12 sm:px-8 lg:px-14">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<Logo light />
				<p class="mt-4 max-w-xs text-sm leading-6 text-white">Manicure inspiration, organized around the details that matter to you.</p>
			</div>
			{groups.map(({ label, kind }) => {
				const pages = indexable.filter((page) => page.kind === kind).slice(0, 8);
				return pages.length > 0 && (
					<div>
						<h2 class="text-xs font-bold uppercase tracking-[0.12em] text-lime">{label}</h2>
						<ul class="mt-4 space-y-2">
							{pages.map((page) => <li><a class="inline-flex min-h-8 items-center text-sm text-white underline decoration-muted underline-offset-4 hover:text-white" href={buildFacetRoute(page.area, page.slug)}>{formatFacetLabel(page)}</a></li>)}
						</ul>
					</div>
				);
			})}
		</div>
		<div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-ink-soft pt-5 text-xs text-white">
			<p>© {new Date().getFullYear()} Nail.ai</p>
			<nav aria-label="Footer links"><a class="font-semibold underline underline-offset-4 hover:text-white" href="/about/">About</a></nav>
		</div>
	</div>
</footer>