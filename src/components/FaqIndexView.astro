---
import type { FaqIndexPageViewModel } from '../application/view-models';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Section from './ui/Section.astro';

interface Props extends FaqIndexPageViewModel {}

const { layout, heading, intro, breadcrumbs, items } = Astro.props;
---

<BaseLayout {...layout}>
	<main>
		<Section bg="canvas">
			<div class="mx-auto max-w-3xl">
				<Breadcrumbs items={breadcrumbs} />
				<h1 class="font-display text-4xl text-ink">{heading}</h1>
				<p class="mt-4 text-base leading-7 text-muted">{intro}</p>
				{items.length > 0
					? <ol class="mt-8 space-y-4">
						{items.map(({ question, answer, href }) => (
							<li class="rounded-card border border-line bg-surface px-6 py-5 shadow-soft">
								<h2 class="font-display text-2xl font-semibold leading-snug text-ink">
									<a class="text-link text-ink" href={href}>{question}</a>
								</h2>
								<p class="mt-3 text-base leading-7 text-ink-soft">{answer}</p>
							</li>
						))}
					</ol>
					: <p class="mt-8 text-base leading-7 text-muted">New answers are coming soon.</p>}
			</div>
		</Section>
	</main>
</BaseLayout>
