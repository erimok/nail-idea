---
import type { NailRecord } from '../libs/ai/nail-search';
import NailCard from './NailCard.astro';

interface Props {
	items: readonly { nail: NailRecord; eager?: boolean }[];
	deferredItems?: readonly { nail: NailRecord }[];
	batchSize?: number;
	totalCount?: number;
}

const { items, deferredItems = [], batchSize, totalCount = items.length } = Astro.props;
---

<div data-gallery-container>
	<div class="grid grid-cols-1 gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3" data-gallery-grid>
		{items.map(({ nail, eager }) => <NailCard nail={nail} eager={eager} />)}
		{deferredItems.map(({ nail }) => <NailCard nail={nail} deferred />)}
	</div>
	<dialog data-gallery-dialog aria-label="Image gallery" class="m-auto h-dvh max-h-none w-screen max-w-none bg-transparent p-0 backdrop:bg-ink/90">
		<figure class="flex h-full w-full flex-col items-center justify-center gap-3 p-4 sm:p-10">
			<img data-gallery-image alt="" class="max-h-[80dvh] max-w-full rounded-card object-contain" />
			<figcaption data-gallery-caption class="text-center text-sm text-white"></figcaption>
		</figure>
		<button type="button" data-gallery-close aria-label="Close gallery" class="absolute right-4 top-4 flex size-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-xl text-ink">×</button>
		<button type="button" data-gallery-prev aria-label="Previous image" class="absolute left-4 top-1/2 flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/90 text-xl text-ink">‹</button>
		<button type="button" data-gallery-next aria-label="Next image" class="absolute right-4 top-1/2 flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/90 text-xl text-ink">›</button>
	</dialog>
	{deferredItems.length > 0 && batchSize !== undefined && <div class="mt-6 flex flex-col items-center gap-3" data-gallery-controls>
		<p class="text-sm text-muted" aria-live="polite" data-gallery-status>Showing {items.length} of {totalCount} designs</p>
		<button
			type="button"
			class="cursor-pointer rounded-full border border-line bg-surface px-5 py-3 font-semibold text-ink shadow-soft transition hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive"
			data-show-more
			data-batch-size={batchSize}
			data-total-count={totalCount}
		>Show more designs</button>
	</div>}
	<noscript>
		{deferredItems.length > 0 && <style>
			[data-gallery-deferred][hidden] { display: flex !important; }
			[data-show-more] { display: none !important; }
		</style>}
	</noscript>
</div>

<script>
	import { initGridGallery } from '../libs/gallery/grid-gallery';
	import { initShowMore } from '../libs/gallery/show-more';

	document.querySelectorAll<HTMLElement>('[data-gallery-grid]').forEach((grid) => {
		const dialog = grid.nextElementSibling;
		if (dialog instanceof HTMLDialogElement) initGridGallery(grid, dialog);
		const container = grid.parentElement;
		const button = container?.querySelector<HTMLButtonElement>('[data-show-more]');
		const status = container?.querySelector<HTMLElement>('[data-gallery-status]');
		if (button && status) initShowMore(grid, button, status);
	});
</script>
