---
interface BreadcrumbItem {
	label: string;
	href?: string;
}

interface Props {
	items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-4">
	<ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
		{items.map((item, index) => (
			<li class="flex items-center gap-2">
				{index > 0 && <span aria-hidden="true" class="text-muted">/</span>}
				{item.href
					? <a class="underline decoration-line underline-offset-4 transition-colors hover:text-coral" href={item.href}>{item.label}</a>
					: <span aria-current="page" class="text-ink-soft">{item.label}</span>}
			</li>
		))}
	</ol>
</nav>