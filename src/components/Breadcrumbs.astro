---
interface BreadcrumbItem {
	label: string;
	href?: string;
}

interface Props {
	items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-4">
	<ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-[#7c8980]">
		{items.map((item, index) => (
			<li class="flex items-center gap-2">
				{index > 0 && <span aria-hidden="true" class="text-[#a8b2a9]">/</span>}
				{item.href
					? <a class="underline decoration-[#c7d0c5] underline-offset-4 transition-colors hover:text-[#d6694c]" href={item.href}>{item.label}</a>
					: <span aria-current="page" class="text-[#45594d]">{item.label}</span>}
			</li>
		))}
	</ol>
</nav>