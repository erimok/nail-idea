---
import { facetKinds, formatFacetLabel, type NailFacetPage } from '../libs/seo-pages';
import { isIndexable } from '../libs/hub-index';

interface Props {
	pages: readonly NailFacetPage[];
	title: string;
	currentSlug?: string;
	variant?: 'default' | 'footer';
}

const { pages, title, currentSlug, variant = 'default' } = Astro.props;
const indexablePages = pages.filter(isIndexable);
const includeArea = new Set(indexablePages.map((page) => page.area)).size > 1;
const groupLabels = {
	color: 'Colors',
	type: 'Design styles',
	occasion: 'Occasions',
	season: 'Seasons',
	shape: 'Shapes',
	length: 'Lengths',
	finishing: 'Finishes',
};
---

<nav aria-label={title} hidden={indexablePages.length === 0} class:list={[
	variant === 'footer' ? 'w-full' : 'border-y border-line py-7',
]}>
	<h2 class:list={[
		'font-display text-2xl',
		variant === 'footer' ? 'text-white' : 'text-ink',
	]}>{title}</h2>
	<div class:list={[
		'mt-5 grid gap-6',
		variant === 'footer' ? 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-7' : 'sm:grid-cols-2 lg:grid-cols-3',
	]}>
		{facetKinds.map((kind) => {
			const groupPages = indexablePages.filter((page) => page.kind === kind && page.slug !== currentSlug);
			return groupPages.length > 0 && (
				<div>
					<h3 class:list={[
						'text-xs font-bold uppercase tracking-[0.12em]',
						variant === 'footer' ? 'text-white/80' : 'text-muted',
					]}>{groupLabels[kind]}</h3>
					<ul class:list={['mt-3 flex flex-wrap', variant === 'footer' ? 'gap-x-3 gap-y-2' : 'gap-2']}>
						{groupPages.map((page) => (
							<li class="max-w-full">
								<a class:list={[
									'max-w-full transition-colors hover:text-coral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive',
									variant === 'footer'
										? 'text-xs text-white underline decoration-muted underline-offset-4'
										: 'inline-flex min-h-9 items-center rounded-full border border-line bg-white px-3.5 py-2 text-xs font-semibold text-ink-soft hover:border-olive hover:bg-tint hover:text-ink',
								]} href={`/${page.area}/${page.slug}/`}>
									{includeArea ? `${formatFacetLabel(page)} ${page.area}` : formatFacetLabel(page)}
								</a>
							</li>
						))}
					</ul>
				</div>
			);
		})}
	</div>
</nav>