---
import { facetKinds, formatFacetLabel, type NailFacetPage } from '../libs/seo-pages';

interface Props {
	pages: readonly NailFacetPage[];
	title: string;
	currentSlug?: string;
}

const { pages, title, currentSlug } = Astro.props;
const groupLabels = {
	color: 'Colors',
	type: 'Design styles',
	occasion: 'Occasions',
	season: 'Seasons',
	shape: 'Shapes',
	length: 'Lengths',
	finishing: 'Finishes',
};
---

<nav aria-label={title} class="border-y border-[#d9dfd4] py-7">
	<h2 class="font-display text-2xl text-[#172b24]">{title}</h2>
	<div class="mt-5 grid gap-6 sm:grid-cols-2">
		{facetKinds.map((kind) => {
			const groupPages = pages.filter((page) => page.kind === kind && page.slug !== currentSlug);
			return groupPages.length > 0 && (
				<div>
					<h3 class="text-xs font-bold uppercase tracking-[0.12em] text-[#7c8980]">{groupLabels[kind]}</h3>
					<ul class="mt-3 flex flex-wrap gap-2">
						{groupPages.map((page) => (
							<li class="max-w-full">
								<a class="inline-flex min-h-9 max-w-full items-center rounded-full border border-[#d9dfd4] bg-white px-3.5 py-2 text-xs font-semibold text-[#45594d] transition-colors hover:border-[#718b42] hover:bg-[#eef3e6] hover:text-[#172b24] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#718b42]" href={`/${page.area}/${page.slug}/`}>
									{formatFacetLabel(page)}
								</a>
							</li>
						))}
					</ul>
				</div>
			);
		})}
	</div>
</nav>