---
import type { FacetBrowseLinksViewModel } from '../application/view-models';

interface Props extends FacetBrowseLinksViewModel {}

const { groups, title } = Astro.props;
---

<nav aria-label={title} hidden={groups.length === 0}>
	<h2 class="font-display text-4xl font-semibold leading-[1.15] text-ink sm:text-5xl">{title}</h2>
	<div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
		{groups.map(({ label, links }) => (
			<div>
				<h3 class="eyebrow !text-muted">{label}</h3>
				<ul class="mt-4 flex flex-wrap gap-x-5 gap-y-3">
					{links.map(({ href, label: linkLabel }) => (
						<li class="max-w-full">
							<a class="text-link text-base font-medium text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-olive" href={href}>{linkLabel}</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</nav>
