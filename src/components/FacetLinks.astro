---
import { facetKinds, formatFacetLabel, type NailFacetPage } from '../libs/seo-pages';

interface Props {
	pages: readonly NailFacetPage[];
	title: string;
	currentSlug?: string;
	variant?: 'default' | 'footer';
}

const { pages, title, currentSlug, variant = 'default' } = Astro.props;
const includeArea = new Set(pages.map((page) => page.area)).size > 1;
const groupLabels = {
	color: 'Colors',
	type: 'Design styles',
	occasion: 'Occasions',
	season: 'Seasons',
	shape: 'Shapes',
	length: 'Lengths',
	finishing: 'Finishes',
};
---

<nav aria-label={title} class:list={[
	variant === 'footer' ? 'w-full' : 'border-y border-[#d9dfd4] py-7',
]}>
	<h2 class:list={[
		'font-display text-2xl text-[#172b24]',
		variant === 'footer' && 'text-white',
	]}>{title}</h2>
	<div class:list={[
		'mt-5 grid gap-6',
		variant === 'footer' ? 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-7' : 'sm:grid-cols-2 lg:grid-cols-3',
	]}>
		{facetKinds.map((kind) => {
			const groupPages = pages.filter((page) => page.kind === kind && page.slug !== currentSlug);
			return groupPages.length > 0 && (
				<div>
					<h3 class:list={[
						'text-xs font-bold uppercase tracking-[0.12em]',
						variant === 'footer' ? 'text-[#a9b5aa]' : 'text-[#7c8980]',
					]}>{groupLabels[kind]}</h3>
					<ul class:list={['mt-3 flex flex-wrap', variant === 'footer' ? 'gap-x-3 gap-y-2' : 'gap-2']}>
						{groupPages.map((page) => (
							<li class="max-w-full">
								<a class:list={[
									'max-w-full transition-colors hover:text-[#d6694c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#718b42]',
									variant === 'footer'
										? 'text-xs text-[#e1e5dc] underline decoration-[#617269] underline-offset-4'
										: 'inline-flex min-h-9 items-center rounded-full border border-[#d9dfd4] bg-white px-3.5 py-2 text-xs font-semibold text-[#45594d] hover:border-[#718b42] hover:bg-[#eef3e6] hover:text-[#172b24]',
								]} href={`/${page.area}/${page.slug}/`}>
									{includeArea ? `${formatFacetLabel(page)} ${page.area}` : formatFacetLabel(page)}
								</a>
							</li>
						))}
					</ul>
				</div>
			);
		})}
	</div>
</nav>