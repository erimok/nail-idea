---
import type { HomepageViewModel } from '../application/view-models';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowseFeatureCard from './BrowseFeatureCard.astro';
import CategoryCard from './CategoryCard.astro';
import FaqSection from './FaqSection.astro';
import HomeHero from './HomeHero.astro';
import NailCollectionGrid from './NailCollectionGrid.astro';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Chip from './ui/Chip.astro';

interface Props extends HomepageViewModel {}

const { layout, nails, searchRecords, featured, categories, faqItems, browseFeatures } = Astro.props;
const primaryArea = layout.siteChrome.header.availableAreas[0];
---

<BaseLayout {...layout}>
	<main>
		<HomeHero nails={nails} searchRecords={searchRecords} />
		<Section bg="surface">
			<div class="grid gap-8 lg:grid-cols-2 lg:gap-14">
				<div class="max-w-prose">
					<p class="mb-2 text-xs font-bold uppercase tracking-[0.12em] text-coral">Find your next look</p>
					<h2 class="font-display text-3xl text-ink">Manicure ideas for the way you live</h2>
					<p class="mt-4 text-base leading-7 text-ink-soft">Not sure what to ask your nail tech for? Describe the look you have in mind and Nail.ai turns it into a clear plan.</p>
					<p class="mt-4 text-base leading-7 text-ink-soft">Browse designs by color, shape, style, or occasion, then bring a reference you like to your appointment. Add details to your search to narrow down the closest looks.</p>
				</div>
				<div class="grid gap-5 sm:grid-cols-2">
					{browseFeatures.map((feature) => <BrowseFeatureCard {...feature} />)}
				</div>
			</div>
		</Section>
		{categories.length > 0 && <Section bg="canvas">
			<SectionHeader title="Browse nail designs by category" eyebrow="Explore the collection" />
			<div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{categories.map((category) => <CategoryCard {...category} />)}
			</div>
		</Section>}
		<Section bg="surface">
			<SectionHeader title="Featured nail ideas" eyebrow="From the Nails collection">
				{primaryArea && <a slot="action" class="text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 transition-colors hover:text-coral" href={primaryArea.href}>View all {primaryArea.label.toLowerCase()} ideas</a>}
			</SectionHeader>
			<p class="-mt-5 mb-6 max-w-prose text-sm leading-6 text-muted">Designs are organized by color, shape, length, finish, and occasion. Nail design photos are AI-generated visual references and may differ from results on natural nails.</p>
			<NailCollectionGrid items={featured.map((nail, index) => ({ nail, eager: index < 3 }))} />
			{primaryArea && <div class="mt-8 flex justify-center"><Chip href={primaryArea.href}>View all {primaryArea.label.toLowerCase()} ideas</Chip></div>}
		</Section>
		<FaqSection items={faqItems} />
	</main>
</BaseLayout>
