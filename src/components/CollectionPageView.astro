---
import type { CollectionPageViewModel } from '../application/view-models';
import BaseLayout from '../layouts/BaseLayout.astro';
import AiImageDisclosure from './AiImageDisclosure.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FacetLinks from './FacetLinks.astro';
import IdeaExplorer from './IdeaExplorer';
import NailCollectionGrid from './NailCollectionGrid.astro';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import FaqSection from './FaqSection.astro';

// Above-the-fold cards load eagerly to protect LCP.
const EAGER_IMAGE_COUNT = 3;

interface Props extends CollectionPageViewModel {}

const {
	layout,
	heading,
	prompt,
	paragraphs,
	intro = [],
	editorialSections = [],
	designs,
	designGrid,
	searchRecords,
	breadcrumbs,
	relatedLinks,
	coreStyleLink,
	sectionTitle,
	faq,
	emptyStateMessage,
} = Astro.props;

const initialDesigns = designGrid?.initial ?? designs;
const deferredDesigns = designGrid?.remaining ?? [];
---

<BaseLayout {...layout} pinterest={designs.length > 0 || searchRecords.length > 0}>
	<main>
		<Section bg="canvas">
			<div class="max-w-3xl">
				<Breadcrumbs items={breadcrumbs} />
				<h1 class="mt-5 font-display text-3xl text-ink">{heading}</h1>
				{intro.length > 0 && <p class="mt-3 max-w-prose text-base leading-7 text-muted">{intro.map(({ text, href }) => href ? <a href={href} class="text-link text-ink">{text}</a> : text)}</p>}
				<div class="mt-5 max-w-2xl"><AiImageDisclosure /></div>
				{coreStyleLink && <p class="mt-3 max-w-prose text-base leading-7 text-muted">Part of our <a href={coreStyleLink.href} class="text-link text-ink">{coreStyleLink.label}</a> collection with {coreStyleLink.designCount} designs.</p>}
				{paragraphs.map((paragraph) => <p class="mt-3 max-w-prose text-base leading-7 text-muted">{paragraph}</p>)}
				<div class="mt-6 max-w-2xl"><IdeaExplorer nails={searchRecords} initialPrompt={prompt} canonical={import.meta.env.PROD ? layout.canonical : undefined} compact client:idle /></div>
			</div>
		</Section>
		<Section bg="surface">
			<SectionHeader title={sectionTitle} />
			{designs.length > 0
				? <NailCollectionGrid
					items={initialDesigns.map((nail, index) => ({ nail, eager: index < EAGER_IMAGE_COUNT }))}
					deferredItems={deferredDesigns.map((nail) => ({ nail }))}
					batchSize={designGrid?.batchSize}
					totalCount={designs.length}
					canonical={layout.canonical}
				/>
				: <p class="text-base leading-7 text-muted">{emptyStateMessage}</p>}
		</Section>
		{editorialSections.length > 0 && <Section bg="canvas">
			<div class="mx-auto max-w-3xl space-y-8">
				{editorialSections.map(({ heading: sectionHeading, body }) => <section>
					<h2 class="font-display text-2xl text-ink">{sectionHeading}</h2>
					<p class="mt-3 max-w-prose text-base leading-7 text-muted">{body}</p>
				</section>)}
			</div>
		</Section>}
		{faq.length > 0 && <FaqSection items={faq} indexHref={layout.siteChrome.faqIndexHref} />}
		{relatedLinks && <Section bg="canvas"><FacetLinks {...relatedLinks} /></Section>}
	</main>
</BaseLayout>

<script>
	import { initPinterestWidgets } from '../adapters/presentation/human/pinterest-widget';
	initPinterestWidgets(document.body);
</script>
