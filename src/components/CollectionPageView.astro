---
import type { CollectionPageViewModel } from '../application/view-models';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FacetLinks from './FacetLinks.astro';
import IdeaExplorer from './IdeaExplorer';
import NailCollectionGrid from './NailCollectionGrid.astro';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';

// Above-the-fold cards load eagerly to protect LCP.
const EAGER_IMAGE_COUNT = 3;

interface Props extends CollectionPageViewModel {}

const {
	layout,
	heading,
	prompt,
	paragraphs,
	intro = [],
	designs,
	designGrid,
	searchRecords,
	breadcrumbs,
	relatedLinks,
	coreStyleLink,
	sectionTitle,
	faq,
	emptyStateMessage,
} = Astro.props;

const initialDesigns = designGrid?.initial ?? designs;
const deferredDesigns = designGrid?.remaining ?? [];
---

<BaseLayout {...layout}>
	<main>
		<Section bg="canvas">
			<div class="max-w-3xl">
				<Breadcrumbs items={breadcrumbs} />
				<h1 class="mt-5 font-display text-3xl text-ink">{heading}</h1>
				{intro.length > 0 && <p class="mt-3 max-w-prose text-base leading-7 text-muted">{intro.map(({ text, href }) => href ? <a href={href} class="text-link text-ink">{text}</a> : text)}</p>}
				{coreStyleLink && <p class="mt-3 max-w-prose text-base leading-7 text-muted">Part of our <a href={coreStyleLink.href} class="text-link text-ink">{coreStyleLink.label}</a> collection with {coreStyleLink.designCount} designs.</p>}
				{paragraphs.map((paragraph) => <p class="mt-3 max-w-prose text-base leading-7 text-muted">{paragraph}</p>)}
				<div class="mt-6 max-w-2xl"><IdeaExplorer nails={searchRecords} initialPrompt={prompt} compact client:idle /></div>
			</div>
		</Section>
		<Section bg="surface">
			<SectionHeader title={sectionTitle} />
			{designs.length > 0
				? <NailCollectionGrid
					items={initialDesigns.map((nail, index) => ({ nail, eager: index < EAGER_IMAGE_COUNT }))}
					deferredItems={deferredDesigns.map((nail) => ({ nail }))}
					batchSize={designGrid?.batchSize}
					totalCount={designs.length}
				/>
				: <p class="text-base leading-7 text-muted">{emptyStateMessage}</p>}
		</Section>
		{faq.length > 0 && <Section bg="tint">
			<div class="grid gap-8 lg:grid-cols-[minmax(220px,0.7fr)_minmax(0,1.3fr)] lg:gap-14">
				<div><h2 class="font-display text-3xl text-ink">Frequently asked questions</h2></div>
				<div>{faq.map(({ question, answer }) => <details class="border-b border-line py-5"><summary class="cursor-pointer font-display text-xl text-ink">{question}</summary><p class="mt-3 max-w-prose text-base leading-7 text-ink-soft">{answer}</p></details>)}</div>
			</div>
		</Section>}
		{relatedLinks && <Section bg="canvas"><FacetLinks {...relatedLinks} /></Section>}
	</main>
</BaseLayout>
